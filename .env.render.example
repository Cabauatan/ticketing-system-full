# Copy settings to Render; keep the existing local .env unchanged.
# Replace every replace-* value and supply APP_KEY before deploying.
APP_NAME=SupportDesk
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://replace-api-service.onrender.com
FRONTEND_URL=https://replace-frontend.pages.dev
CORS_ALLOWED_ORIGINS=https://replace-frontend.pages.dev
# Only behind Render's inaccessible container edge, never a public direct server.
TRUSTED_PROXIES=*
LOG_CHANNEL=stderr
LOG_LEVEL=warning
PORT=10000

DB_CONNECTION=mysql
DB_HOST=replace-host.aivencloud.com
DB_PORT=replace-aiven-port
DB_DATABASE=ticketing
DB_USERNAME=replace-database-user
DB_PASSWORD=replace-database-password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_SSL_CA=/etc/secrets/ca.pem
# MYSQL_ATTR_SSL_CA takes precedence if both CA variables are supplied.
# MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem
# Certificate verification is always enabled when a CA is configured.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
# pages.dev -> onrender.com; see the same-site custom-domain option in the guide.
SESSION_SAME_SITE=none
SESSION_COOKIE=ticketing-session
CACHE_STORE=database
QUEUE_CONNECTION=sync

# No migrations run unless explicitly enabled for a reviewed deployment.
RUN_MIGRATIONS=false
# Existing real-time events and SLA/7-day priority escalation need these.
RUN_REVERB=true
RUN_SCHEDULER=true
RUN_QUEUE_WORKER=false

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=replace-reverb-id
REVERB_APP_KEY=replace-public-reverb-key
REVERB_APP_SECRET=replace-private-reverb-secret
# Backend publishes internally; browsers use the public API hostname:443.
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081
# Hostnames here; complete scheme://host origins in CORS_ALLOWED_ORIGINS.
REVERB_ALLOWED_ORIGINS=replace-frontend.pages.dev

# Choose a provider supporting an unblocked SMTP port such as 2525.
# Render Free blocks 25, 465 and 587; Gmail SMTP will not work on this plan.
# Brevo SMTP uses smtp-relay.brevo.com; use its SMTP Login and SMTP key.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=replace-smtp-provider-host
MAIL_PORT=2525
MAIL_TIMEOUT=10
MAIL_USERNAME=replace-smtp-username
MAIL_PASSWORD=replace-smtp-password
MAIL_FROM_ADDRESS=support@replace-verified-domain.example
MAIL_FROM_NAME=SupportDesk

# Attachment/avatar controllers use local disks; files are ephemeral on Free.
FILESYSTEM_DISK=local

# Optional, explicit one-time CLI seeding only; never seed during startup.
# SUPERADMIN_EMAIL=replace-admin-email@example.com
# SUPERADMIN_PASSWORD=replace-with-a-new-strong-password
# SUPERADMIN_NAME=Superadmin
