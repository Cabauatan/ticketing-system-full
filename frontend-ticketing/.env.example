# Keep API requests on the Vue origin so Laravel session cookies and CSRF work.
VITE_API_URL=
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://192.168.100.51:8001
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5001

# Leave blank to connect Reverb through the hostname used to open Vue.
# The public Reverb app key is loaded from the backend .env.
VITE_REVERB_HOST=
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http
